# Backend Environment Variables
# NEVER commit real secrets. On Render, set these as environment variables.

# Supabase PostgreSQL connection string (direct connection, port 5432).
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Generate a strong random secret, e.g. `openssl rand -hex 32`
JWT_SECRET="<GENERATE_A_STRONG_SECRET>"

# Render injects PORT automatically. Local default is 5000.
PORT=5000

# Public URL of the deployed frontend (used for CORS and QR code URLs).
FRONTEND_URL="https://your-frontend.onrender.com"

# Comma-separated list of allowed browser origins (e.g. localhost + production).
CORS_ORIGINS="http://localhost:5173,https://your-frontend.onrender.com"

TIMEZONE="Asia/Kolkata"
HACKATHON_START_TIME="09:00"
HACKATHON_END_TIME="17:00"

# Admin credentials created by `npm run seed` on first deploy.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<SET_A_STRONG_ADMIN_PASSWORD>"