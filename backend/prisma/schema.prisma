generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Participant {
  id             String   @id @default(uuid())
  registerNumber String   @unique
  name           String
  email          String?
  phone          String?
  department     String?
  year           String?
  teamName       String?
  hallName       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendances Attendance[]
}

model Attendance {
  id              String          @id @default(uuid())
  participantId   String
  participant     Participant     @relation(fields: [participantId], references: [id])
  checkInDate     DateTime?
  checkInTime     DateTime?
  checkOutDate    DateTime?
  checkOutTime    DateTime?
  status          AttendanceStatus @default(CHECKED_IN)
  checkInHall     String?
  checkOutHall    String?
  isLate          Boolean         @default(false)
  isEarlyCheckout Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // (participantId, status) serves the hot lookup "active attendance for a
  // participant" used by check-in, check-out, dashboard and reports.
  @@index([participantId, status])
  // Supports the default createdAt DESC ordering / pagination.
  @@index([createdAt])
  @@index([checkInDate])

  // NOTE: partial unique indexes enforcing ONE active check-in per
  // participant cannot be expressed in Prisma schema. They are created in
  // raw SQL migrations:
  //   20260821000000_concurrency_safety:
  //     CREATE UNIQUE INDEX "Attendance_participantId_checkedIn_key"
  //       ON "Attendance"("participantId") WHERE "status" = 'CHECKED_IN';
  //   20260821010000_one_active_check_in_per_participant:
  //     CREATE UNIQUE INDEX "Attendance_participantId_activeCheckout_key"
  //       ON "Attendance"("participantId")
  //       WHERE "checkInTime" IS NOT NULL AND "checkOutTime" IS NULL;
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  registerNumber String
  timestamp      DateTime @default(now())
  ipAddress      String?
  userAgent      String?
}

model Hall {
  id        String   @id @default(uuid())
  name      String   @unique
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}
